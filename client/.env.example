VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
VITE_DISCORD_CLIENT_ID=your_discord_client_id
VITE_DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord/callback
VITE_FACEBOOK_APP_ID=your_facebook_app_id

# Giphy key lives on the SERVER only (Fly secret / server/.env as GIPHY_API_KEY).
# Client searches via GET /api/gifs/search — do not put the key in Vercel. 